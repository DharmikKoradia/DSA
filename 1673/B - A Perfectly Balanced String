#include <bits/stdc++.h>
using namespace std;
 
 
//Macro definition
typedef long long ll;
typedef vector<int> vi;
#define PB push_back
#define POP pop_back()
#define FOR(i,a,b) for(int i=a;i<b;i++)
#define DEBUG(x) cerr<<#x<<" = "<<x;
 
void solve()
{
    string s;
    cin>>s;
    
    string pat="";
    
    vector<bool> seen(26,false);
    
    for(char t:s){
        if(!seen[t-'a']) pat+=t;
        else break;
        
        seen[t-'a']=true;
    }
    
    int p=pat.size();
    for(int i=0;i<s.size();i++){
        if(s[i]!=pat[i%p]){
            cout<<"No
";
            return;
        }
    }
    cout<<"Yes
";
}
 
int main() {
    ios::sync_with_stdio(false);
    cin.tie(nullptr);
    int t=1;
    cin>>t;
    while(t--)
    {
	    solve();
    }
}