#include <iostream>
#include<vector>
 
using namespace std;
void solve(){
    bool ans=false;
    int n,k;
    cin>>n>>k;
    for(int i=0;i<n;i++){
        int x;
        cin>>x;
        if(x==k) ans=true;
    }
    if(ans) cout<<"Yes
";
    else cout<<"No
";
}
int main()
{
    int t;
    cin>>t;
    while(t--) solve();
    return 0;
}